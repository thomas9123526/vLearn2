# Virtual Foreign Language System — Production Environment
# Copy this to .env and fill in the values, OR run install.sh which does it automatically.
# WARNING: Never commit .env to git. Keep it secret.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=http://YOUR_SERVER_IP_OR_DOMAIN
CORS_ORIGINS=http://YOUR_SERVER_IP_OR_DOMAIN

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vlearn2
DB_USER=vlearn2
# Generate with: openssl rand -base64 24 | tr -d '=/+'
DB_PASSWORD=CHANGE_ME

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48 | tr -d '=/+'
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_MIN_32_CHARS
JWT_REFRESH_EXPIRES=7d

# ── AI Provider ──────────────────────────────────────────────────────────────
# Option A — Built-in mock (no API key needed, uses pre-canned responses):
AI_PROVIDER=openai-compatible
OPENAI_BASE_URL=http://ai-mock:8081/v1
OPENAI_API_KEY=not-needed
AI_CHAT_MODEL=Qwen3.5-9B-mock
AI_ANALYSIS_MODEL=Qwen3.5-9B-mock

# Option B — Real Anthropic API (uncomment and set your key):
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_CHAT_MODEL=claude-sonnet-4-6
# AI_ANALYSIS_MODEL=claude-haiku-4-5-20251001

# ── AI Mock (always started; used as fallback or primary depending on above) ─
MOCK_MODEL_NAME=Qwen3.5-9B-mock
# If using real Anthropic and want the mock to also have a key for fallback:
# MOCK_ANTHROPIC_API_KEY=sk-ant-...

# ── Security ─────────────────────────────────────────────────────────────────
# Exactly 32 characters. Generate with: openssl rand -base64 24 | tr -d '=/+' | head -c 32
# WARNING: changing this invalidates all encrypted DB fields.
DB_FIELD_ENCRYPTION_KEY=CHANGE_ME_EXACTLY_32_CHARS______

# ── Performance & Limits ─────────────────────────────────────────────────────
GZIP_ENABLED=true
GZIP_THRESHOLD_BYTES=102400
AI_TIMEOUT_MS=60000
# Set to false to suppress all verbose logs. Only error and warn will reach the
# console. The AI call pretty-box logs are also silenced. Useful in production.
# Default: true (all logs enabled).
LOG_ENABLE=true
# Set to true to print a raw JSON dump after every pretty-box AI log entry.
# Useful for inspecting exact prompts and responses sent to/from the model.
# Keep false (or unset) in production — output is very verbose.
AI_RAW_LOG=false
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
MAX_AI_MESSAGES_PER_DAY=100
