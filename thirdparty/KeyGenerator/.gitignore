# CMake out-of-source build trees.
build/
out/

# Visual Studio user state.
.vs/
*.user
*.suo
*.sln.docstates

# CMake artefacts in case anyone configures in-source.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Qt Creator user state.
*.pro.user*
CMakeLists.txt.user*

# FetchContent download cache (re-populated by every fresh build).
_deps/

# Outputs of the hand-rolled .vcxproj path (KeyGenerator.sln).
# `external/qrcodegen/` is cloned by the .vcxproj's pre-build event;
# `generated/` holds moc/uic output. Both are regenerated on demand.
bin/
obj/
generated/
external/
