# ── Mock server ───────────────────────────────────────────────
PORT=8081

# Model name reported in responses (matches what the backend expects)
MOCK_MODEL_NAME=Qwen3.5-9B-mock

# ── Anthropic API (powers the mock responses) ─────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Claude models used internally.
# Haiku is fast and cheap; Sonnet gives richer evaluation output.
CHAT_MODEL=claude-haiku-4-5-20251001
ANALYSIS_MODEL=claude-haiku-4-5-20251001

# ── Logging ───────────────────────────────────────────────────
# Set to "true" to print full request/response bodies
LOG_BODIES=false
