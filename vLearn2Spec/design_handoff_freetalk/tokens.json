{
  "$meta": {
    "name": "FreeTalk Design Tokens",
    "version": "1.0.0",
    "description": "Complete design token system for the FreeTalk English speaking app. Optimized for Flutter ThemeData ingestion but framework-agnostic.",
    "themes": ["apricot", "sage", "iris", "obsidian"],
    "default": "apricot",
    "note": "All themes carry the SAME token names — swap palettes at runtime by switching themes. obsidian is dark; the other three are light."
  },

  "color": {
    "apricot": {
      "$desc": "Warm parchment + terracotta + olive. Mediterranean villa, golden hour. (default)",
      "$mode": "light",
      "bg":          "#FAF6EF",
      "surface":     "#FFFFFF",
      "surfaceAlt":  "#F2EADA",
      "surfaceDeep": "#E8DCC4",
      "ink":         "#2A1D12",
      "inkSoft":     "#6C5641",
      "inkFaint":    "#A8917B",
      "border":      "#46301615",
      "accent":      "#D4633A",
      "accent2":     "#7D8C52",
      "accentSoft":  "#FBE1D1",
      "accentInk":   "#6E2911",
      "good":        "#5E8A4A",
      "warn":        "#C89035",
      "bad":         "#B94A3A",
      "glow": [
        { "stop": "radial-gradient(900px 600px at 78% -10%, #FBE1D1 0%, transparent 62%)" },
        { "stop": "radial-gradient(700px 500px at -8% 92%, #F5E6C8 0%, transparent 70%)" }
      ]
    },
    "sage": {
      "$desc": "Eucalyptus + dusty rose. Quiet, editorial, calming.",
      "$mode": "light",
      "bg":          "#F3F4EE",
      "surface":     "#FFFFFF",
      "surfaceAlt":  "#E6EAE0",
      "surfaceDeep": "#D4DBCC",
      "ink":         "#1D2620",
      "inkSoft":     "#52624F",
      "inkFaint":    "#92A193",
      "border":      "#1E372815",
      "accent":      "#446B54",
      "accent2":     "#C47D6B",
      "accentSoft":  "#D6E2D4",
      "accentInk":   "#1E3326",
      "good":        "#4A8062",
      "warn":        "#C8943F",
      "bad":         "#B8584A"
    },
    "iris": {
      "$desc": "Cool ivory + periwinkle + warm amber. Ethereal, refined, hopeful.",
      "$mode": "light",
      "bg":          "#F6F4FB",
      "surface":     "#FFFFFF",
      "surfaceAlt":  "#EBE6F4",
      "surfaceDeep": "#D8D0E8",
      "ink":         "#1F1932",
      "inkSoft":     "#594B78",
      "inkFaint":    "#9286AD",
      "border":      "#3C1E5A15",
      "accent":      "#6957C2",
      "accent2":     "#D4925A",
      "accentSoft":  "#E0D6F4",
      "accentInk":   "#2E1D75",
      "good":        "#4A8C6E",
      "warn":        "#C98740",
      "bad":         "#B8585A"
    },
    "obsidian": {
      "$desc": "Deep navy + electric teal + warm amber. Luxurious dark mode.",
      "$mode": "dark",
      "bg":          "#0E1424",
      "surface":     "#181F33",
      "surfaceAlt":  "#232B42",
      "surfaceDeep": "#2C3653",
      "ink":         "#EEF1FA",
      "inkSoft":     "#A0AAC7",
      "inkFaint":    "#5E688A",
      "border":      "#A0B2E421",
      "accent":      "#5FC8D2",
      "accent2":     "#F0B562",
      "accentSoft":  "#5FC8D22E",
      "accentInk":   "#B3ECF2",
      "good":        "#6FD8A8",
      "warn":        "#F0B562",
      "bad":         "#FF8676"
    }
  },

  "persona": {
    "$desc": "Speaking-partner accent colors. Saturation-matched so the four read as a family.",
    "maya":  { "accent": "#D97757", "gradient": ["#F7C6A7", "#D97757", "#A44A2A"], "role": "Friendly best friend" },
    "leo":   { "accent": "#4A6FA5", "gradient": ["#B3C7E6", "#4A6FA5", "#233F70"], "role": "Cool mentor" },
    "sofia": { "accent": "#7E5AAF", "gradient": ["#D6C4EE", "#7E5AAF", "#3F2978"], "role": "Academic prof" },
    "theo":  { "accent": "#5A8C6E", "gradient": ["#B6D6BD", "#5A8C6E", "#2A5340"], "role": "Chill traveler" }
  },

  "typography": {
    "families": {
      "display": { "family": "Instrument Serif", "fallback": "Georgia, serif", "use": "Headings, hero numbers, italic-emphasis spans" },
      "ui":      { "family": "Plus Jakarta Sans", "fallback": "system-ui, sans-serif", "use": "All body, buttons, labels" },
      "mono":    { "family": "JetBrains Mono", "fallback": "monospace", "use": "Numbers, scores, timestamps, durations" },
      "cjk_sans": { "family": "Noto Sans SC / Noto Sans KR", "use": "When app language is zh / ko" },
      "cjk_serif": { "family": "Noto Serif SC / Noto Serif KR", "use": "Display headings in zh / ko" }
    },
    "scale": {
      "display1": { "family": "display", "size": 108, "lineHeight": 0.95, "weight": 400, "letterSpacing": -3.24, "use": "Splash wordmark" },
      "display2": { "family": "display", "size": 48,  "lineHeight": 1.18, "weight": 400, "letterSpacing": -0.96, "use": "Report headline" },
      "display3": { "family": "display", "size": 40,  "lineHeight": 1.05, "weight": 400, "letterSpacing": -0.80, "use": "Page titles (desktop)" },
      "display4": { "family": "display", "size": 32,  "lineHeight": 1.05, "weight": 400, "letterSpacing": -0.64, "use": "Page titles (mobile)" },
      "h1":       { "family": "display", "size": 30,  "lineHeight": 1.1,  "weight": 400, "letterSpacing": -0.30, "use": "Card heroes, scenario titles" },
      "h2":       { "family": "display", "size": 22,  "lineHeight": 1.2,  "weight": 400, "letterSpacing": -0.22, "use": "Section heads" },
      "h3":       { "family": "display", "size": 18,  "lineHeight": 1.35, "weight": 400, "letterSpacing": 0,     "use": "Coach note, phrases" },
      "bodyLg":   { "family": "ui",      "size": 16,  "lineHeight": 1.5,  "weight": 400, "use": "Onboarding sub-copy, chat bubble" },
      "body":     { "family": "ui",      "size": 14,  "lineHeight": 1.5,  "weight": 400, "use": "Default body" },
      "bodySm":   { "family": "ui",      "size": 13,  "lineHeight": 1.45, "weight": 400, "use": "Card body, secondary copy" },
      "label":    { "family": "ui",      "size": 12,  "lineHeight": 1.4,  "weight": 500, "use": "Buttons, chip labels" },
      "caption":  { "family": "ui",      "size": 11,  "lineHeight": 1.4,  "weight": 500, "use": "Timestamps, metadata" },
      "overline": { "family": "ui",      "size": 10,  "lineHeight": 1.4,  "weight": 600, "letterSpacing": 1.6, "transform": "uppercase", "use": "Kickers above section heads" },
      "mono":     { "family": "mono",    "size": 12,  "lineHeight": 1.4,  "weight": 500, "use": "Numbers, scores, durations, CEFR tags" }
    }
  },

  "spacing": {
    "$desc": "8-pt grid with 4-pt half steps.",
    "0": 0, "0.5": 2, "1": 4, "1.5": 6, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 28, "8": 32, "10": 40, "12": 48, "14": 56, "16": 64, "20": 80
  },

  "radius": {
    "$desc": "Cards use 12–18, pills use 999, micro-buttons use 8–10.",
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 14,
    "xl": 18,
    "card": 18,
    "pill": 999
  },

  "shadow": {
    "$desc": "Light themes; on dark theme reduce alpha by ~40% and switch to neutral-stop.",
    "sm":  { "offsetY": 1, "blur": 2,  "color": "#0A06030A" },
    "md":  { "offsetY": 4, "blur": 14, "color": "#0A06030A" },
    "lg":  { "offsetY": 12, "blur": 28, "color": "#0A060314" },
    "accent": {
      "$desc": "Accent-glow on primary buttons. Use the theme's accent at 33% alpha.",
      "offsetY": 6, "blur": 16, "color": "{accent}55"
    },
    "card": {
      "offsetY": 4, "blur": 14, "color": "#14100A0A",
      "innerHighlight": "#FFFFFF99 inset 0 1px 0"
    }
  },

  "motion": {
    "$desc": "All durations in ms; curves in cubic-bezier.",
    "curves": {
      "standard":  "cubic-bezier(0.22, 0.61, 0.36, 1)",
      "decel":     "cubic-bezier(0.0, 0.0, 0.2, 1)",
      "overshoot": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "spring":    "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "duration": {
      "instant": 120,
      "fast":    180,
      "base":    280,
      "slow":    420,
      "lazy":    600,
      "epic":    1200
    },
    "patterns": {
      "fadeIn":   "opacity 0->1, translateY 6px->0, 420ms standard",
      "popIn":    "opacity 0->1, scale 0.85->1, 500ms spring",
      "slideUp":  "opacity 0->1, translateY 18px->0, 500ms standard",
      "countUp":  "0 -> target with ease-out-cubic, 1200ms",
      "barGrow":  "scaleX 0->1, transformOrigin left, 1200ms standard",
      "scorering":"strokeDasharray fill, 1500ms standard",
      "pulse":    "scale 1->2.6 + opacity 0.55->0, 1800ms (loop, used behind mic + persona)",
      "wave":     "scaleY 0.3->1->0.3, 600–1400ms randomized per-bar (loop)",
      "shimmer":  "background-position -200% -> 200%, 2400ms (loop, used on text + bars)",
      "confetti": "translateY -40px -> 110vh + rotate 0->540deg + opacity, 2400–4000ms, ease-in-out"
    }
  },

  "i18n": {
    "supported": ["en", "zh", "ko"],
    "default": "en",
    "fontSwap": {
      "zh": { "ui": "Plus Jakarta Sans + Noto Sans SC", "display": "Instrument Serif + Noto Serif SC" },
      "ko": { "ui": "Plus Jakarta Sans + Noto Sans KR", "display": "Instrument Serif + Noto Serif KR" }
    },
    "stringTable": "See strings.json — keys are English source strings, values are translations."
  }
}
