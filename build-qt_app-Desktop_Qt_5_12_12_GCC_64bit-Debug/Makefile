	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents ../qt_app/assets.qrc $(DISTDIR)/
	$(COPY_FILE) --parents ../../../../Qt5.12.12/5.12.12/gcc_64/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents ../qt_app/src/model/Models.h ../qt_app/src/config/AppConfig.h ../qt_app/src/ui/Theme.h ../qt_app/src/api/ApiClient.h ../qt_app/src/auth/LoginDialog.h ../qt_app/src/chat/ChatPage.h ../qt_app/src/chat/HistoryPage.h ../qt_app/src/shell/MainShell.h $(DISTDIR)/
	$(COPY_FILE) --parents ../qt_app/src/main.cpp ../qt_app/src/config/AppConfig.cpp ../qt_app/src/ui/Theme.cpp ../qt_app/src/api/ApiClient.cpp ../qt_app/src/auth/LoginDialog.cpp ../qt_app/src/chat/ChatPage.cpp ../qt_app/src/chat/HistoryPage.cpp ../qt_app/src/shell/MainShell.cpp $(DISTDIR)/


