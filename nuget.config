<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Local feed for offline builds — nupkg files live in flutter_app/windows/nuget_feed/ -->
    <add key="local-offline" value=".\flutter_app\windows\nuget_feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
