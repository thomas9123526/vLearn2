<?xml version="1.0" encoding="utf-8"?>
<!--
  vLearn2 — repo-local NuGet config for OFFLINE Windows builds.

  Why this file exists / how it is found:
    The audioplayers_windows and permission_handler_windows plugins run
    `nuget install ...` during the CMake configure step, with a working
    directory of build\windows\x64. NuGet walks that directory UP to the
    drive root looking for NuGet.Config files, so a config placed here at
    the flutter_app root is discovered for every Windows build.

  What it does:
    * <clear/> drops every inherited package source (machine-wide, the
      per-user %AppData%\NuGet\NuGet.Config, and nuget.org). This makes the
      build deterministic and fully offline — NuGet can ONLY use the local
      feed below, so it never reaches the network even if a source is
      enabled elsewhere.
    * Registers windows\nuget_feed as the sole package source. The path is
      RELATIVE to this file, so it keeps working after a clone / VM transfer
      with no machine-specific config. Drop the required *.nupkg files there
      (see cmds\populate_nuget_feed.ps1).

  Adding a new NuGet package later (while ONLINE):
    Run cmds\populate_nuget_feed.ps1 (it downloads the pinned .nupkg files by
    direct URL — independent of the sources listed here), then build offline.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="vlearn2-local" value="windows/nuget_feed" />
  </packageSources>
</configuration>
