# ─── Server ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# ─── Database (PostgreSQL) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vlearn2
DB_USER=postgres
DB_PASSWORD=dev_password

# ─── Auth (JWT) ─────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-minimum-32-characters-long-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change-me-different-min-32-characters-long
JWT_REFRESH_EXPIRES=7d

# ─── AI Provider ────────────────────────────────────────────
# See todoList/0516/09_ai_integration.md and todoList/0517/01_lmstudio_integration.md
# Switch AI_PROVIDER to one of: anthropic | openai-compatible
AI_PROVIDER=anthropic
AI_CHAT_MODEL=claude-sonnet-4-6
AI_ANALYSIS_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# Used when AI_PROVIDER=openai-compatible (LM Studio / Ollama / Groq / Together / vLLM).
# Defaults below are for LM Studio. For Ollama use port 11434 and a model
# like 'llama3.1:8b'. For Groq, set OPENAI_BASE_URL=https://api.groq.com/openai/v1
# and OPENAI_API_KEY=<your-groq-key>.
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=not-needed
AI_PROVIDER_LABEL=lmstudio
# Model id MUST match the exact name LM Studio shows after loading the model
# (open Developer tab → loaded model → copy the id under the name).
# AI_CHAT_MODEL / AI_ANALYSIS_MODEL above are reused for openai-compatible too.
# Common pick: openai/gpt-oss-20b (Q4_K_M, ~16 GB RAM)

# ─── Content Guard & Compression (see todoList/0516/11) ─────
GZIP_ENABLED=true
GZIP_THRESHOLD_BYTES=102400

# ─── File Storage (see todoList/0516/13 §13.3) ──────────────
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
# Used when STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# ─── Rate Limiting ──────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
MAX_AI_MESSAGES_PER_DAY=100
