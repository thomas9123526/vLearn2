{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/setup.ts"],
  "testTimeout": 60000,
  "forceExit": true,
  "detectOpenHandles": true,
  "verbose": true,
  "reporters": ["default"]
}
