{
  "version": 1,
  "pack_mode": {
    "compress": "zlib",
    "encrypt": "none"
  },
  "signing": {
    "cert_path": "ca/issued/admins/alice/admin.crt",
    "key_path": "ca/issued/admins/alice/admin.key"
  },
  "bundles": [
    {
      "name": "out_model",
      "source_dir": "C:/data/models",
      "out_folder": "models"
    },
    {
      "name": "out_font",
      "source_dir": "C:/data/fonts",
      "out_folder": "fonts"
    },
    {
      "name": "out_secret",
      "source_dir": "C:/data/secret",
      "out_folder": "secret",
      "pack_mode": {
        "compress": "zlib",
        "encrypt": "aes-256-gcm"
      }
    }
  ],
  "output_dir": "./output"
}
